# ─── Client-side (Vite exposes VITE_* vars to the browser bundle) ───────────────

# Supabase project URL — found in: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anonymous/public key — safe to expose in browser code; security enforced by RLS
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# VAPID public key for Web Push subscriptions (must match VAPID_PUBLIC_KEY below)
VITE_VAPID_PUBLIC_KEY=<base64url-vapid-public-key>

# ─── Server-side only (Vercel serverless functions — never expose to browser) ───

# Supabase service role key — bypasses RLS; keep secret
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# VAPID keys for sending Web Push notifications
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@the-unlabeled.com
VAPID_PUBLIC_KEY=<base64url-vapid-public-key>
VAPID_PRIVATE_KEY=<base64url-vapid-private-key>

# Secret sent by the Supabase pg_cron job to authenticate /api/send-notifications
# Generate with: openssl rand -base64 32
CRON_SECRET=<random-secret-at-least-32-chars>
