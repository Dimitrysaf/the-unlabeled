{
  "name": "the-unlabeled",
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src api",
    "lint:fix": "eslint src api --fix",
    "format": "prettier --write \"src/**/*.js\" \"api/**/*.js\" \"*.js\" \"src/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.js\" \"api/**/*.js\" \"*.js\" \"src/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "easymde": "^2.21.0",
    "marked": "^18.0.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "vercel": "^51.8.0",
    "vite": "^8.0.14",
    "vitest": "^3.0.0"
  }
}